{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@hyoper/rn-animated-modal": ["../src/index"]
    },
    "jsx": "react",
    "types": ["node"],
    "moduleResolution": "node",
    "allowImportingTsExtensions": false
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
